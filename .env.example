# Example environment variables for Living Flood Map
# Copy to `.env` and fill with real values (do NOT commit `.env`)

# OpenAI / LLM keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Chroma DB storage dir (optional)
CHROMA_DB_DIR=./.chroma

# Geocoder user agent for geopy.Nominatim
GEOCODER_USER_AGENT=living-flood-map

# CARTO basemap key for Folium map tiles
CARTO_BASEMAP_KEY=