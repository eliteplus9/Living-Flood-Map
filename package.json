{
  "name": "living-flood-map",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build --config frontend/vite.config.ts",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "verify": "npm run check && npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "papaparse": "5.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "1.9.20",
    "@types/node": "24.5.2",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "wrangler": "4.141.0"
  }
}
